class Student
{
    String name;
    int id;
    void set(String name,int id)
    {
        this.name=name;
        this.id=id;
    }
    void display()
    {
        System.out.println(this.name+" "+this.id);
    }
}
public class Main
{
	public static void main(String[] args) {
	   Student obj=new Student();
	   obj.set("Akshara",1);
	   obj.display();
	}
}
