public class Main
{
	public static void main(String[] args) {
    int a[][]={{1,2},{3,4}};
    int b[][]={{4,5},{6,7}};
    int size=a.length;
    int c[][]=new int[size][size];
    int i,j,k;
    for(i=0;i<size;i++)
    {
        for(j=0;j<size;j++)
        {
            for(k=0;k<size;k++)
            {
                c[i][j]=c[i][j]+a[i][k]*b[k][j];
            }
        }
    }
     for(i=0;i<size;i++)
    {
        for(j=0;j<size;j++)
        {
            System.out.print(c[i][j]+" ");
        }
        System.out.println();
    }
    
	}
}
