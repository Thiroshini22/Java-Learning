public class Main
{
	public static void main(String[] args) {
		int a[][]={{1,2},{3,4}};
		int b[][]={{5,6},{7,8}};
		int size=a.length;
		int i,j;
		int c[][]=new int[size][size];
		for(i=0;i<size;i++)
		{
		    for(j=0;j<size;j++)
		    {
		       c[i][j]=a[i][j]+b[i][j]; 
		       System.out.print(c[i][j]+" ");
		    }
		    System.out.println();
		}
		
	}
}

