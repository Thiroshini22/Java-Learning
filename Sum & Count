import  java.util.*;
public class Main
{
	public static void main(String[] args) {
	    int arr[]={10,20,30,40,50};
		int sum=0, i ,oddcount=0,evencount=0;
		for(i=0;i<arr.length;i++)
		{
		    sum=sum+arr[i];
		    if(arr[i]%2==0)
		    {
		        evencount++;

		    }
		    else
		    {
		        oddcount++;
		        
		    }
		}
				        System.out.println("Evev Count = "+evencount);
				        System.out.println("Odd Count = "+oddcount);
		System.out.println("Total Suum ="+sum);
	}
}
